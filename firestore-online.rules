// À fusionner dans le bloc match /databases/{database}/documents des règles
// du projet amertume-rpg. Ce fichier NE remplace PAS les règles de l'autre app.
// Aucun allow write global ne doit couvrir ces collections : les allow s'additionnent.
function isOnlineMJ() {
  return request.auth != null
    && exists(/databases/$(database)/documents/amertume_online_admins/$(request.auth.uid))
    && get(/databases/$(database)/documents/amertume_online_admins/$(request.auth.uid)).data.active == true;
}
match /amertume_online_admins/{uid} {
  allow get: if request.auth != null && request.auth.uid == uid;
  allow list, write: if false; // Administrateurs ajoutés depuis la console uniquement.
}
match /amertume_online_public/main {
  allow get: if request.auth != null; // v0.717 : lecture réservée aux comptes connectés.
  allow list, delete: if false;
  allow create, update: if isOnlineMJ()
    && request.resource.data.keys().hasOnly(['revision','parts','bytes','updatedAt','author'])
    && request.resource.data.revision is string
    && request.resource.data.revision.matches('^[A-Za-z0-9_-]{1,100}$')
    && request.resource.data.parts is int
    && request.resource.data.parts > 0 && request.resource.data.parts <= 86
    && request.resource.data.bytes is int
    && request.resource.data.bytes > 0 && request.resource.data.bytes <= 16777216
    && request.resource.data.author == request.auth.uid;
}
match /amertume_online_versions/{revision}/parts/{part} {
  allow get: if request.auth != null; // v0.717 : lecture réservée aux comptes connectés.
  allow list: if false;
  allow create: if isOnlineMJ()
    && request.resource.data.keys().hasOnly(['data'])
    && request.resource.data.data is string
    && request.resource.data.data.size() <= 262144;
  allow update: if false; // Versions immuables, publication via le manifeste ci-dessus.
  allow delete: if isOnlineMJ();
}

// ---- Table en ligne (v0.91, clés à jour en v0.184) : la partie jouée à plusieurs ----
// La liste des clés doit suivre CHAMPS_MJ de live.js : checks.cjs le vérifie.
// Le code de la table tient lieu de clef : il faut connaître son identifiant pour la
// lire. Le MJ seul l'ouvre et la ferme ; tout joueur connecté — même anonymement —
// pousse l'état vivant des combattants et des portes, jamais le tour ni le verrou.
match /amertume_online_live/{table} {
  // v0.752 : un compte exclu par le MJ (bannis/{uid}) ne lit ni n'écrit plus rien de la table.
  allow get: if request.auth != null
    && !exists(/databases/$(database)/documents/amertume_online_live/$(table)/bannis/$(request.auth.uid));
  allow list: if false; // Les tables ne s'énumèrent pas.
  allow create: if isOnlineMJ() && request.resource.data.mj == request.auth.uid;
  allow delete: if isOnlineMJ() && resource.data.mj == request.auth.uid;
  allow update: if request.auth != null
    && resource.data.mj is string
    && request.resource.data.mj == resource.data.mj
    && request.resource.data.keys().hasOnly(['actors','doors','round','locked','title','mode','mapId','mj','at','fogOff','fogReset'])
    && (isOnlineMJ()
        || (!exists(/databases/$(database)/documents/amertume_online_live/$(table)/bannis/$(request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actors','doors','at'])));

  // Les exclus (v0.752) : le MJ les inscrit et les réadmet ; chacun peut voir s'il l'est.
  match /bannis/{uid} {
    allow get: if request.auth != null && (request.auth.uid == uid || isOnlineMJ());
    allow list: if isOnlineMJ();
    allow create, update: if isOnlineMJ() && request.resource.data.keys().hasOnly(['nom','at']);
    allow delete: if isOnlineMJ();
  }

  // L'exploration de chaque carte (v0.766) : le MJ l'écrit, tout joueur de la table la lit.
  match /brouillard/{carte} {
    allow get, list: if request.auth != null
      && !exists(/databases/$(database)/documents/amertume_online_live/$(table)/bannis/$(request.auth.uid));
    allow create, update: if isOnlineMJ()
      && request.resource.data.keys().hasOnly(['f','n','at'])
      && request.resource.data.f is string
      && request.resource.data.f.size() <= 300000
      && request.resource.data.n is int;
    allow delete: if isOnlineMJ();
  }

  match /seats/{uid} {
    allow get, list: if request.auth != null
      && !exists(/databases/$(database)/documents/amertume_online_live/$(table)/bannis/$(request.auth.uid));
    allow create, update: if request.auth != null && request.auth.uid == uid
      && !exists(/databases/$(database)/documents/amertume_online_live/$(table)/bannis/$(request.auth.uid))
      && request.resource.data.keys().hasOnly(['actorId','nom','at'])
      && request.resource.data.actorId is string
      && request.resource.data.actorId.size() <= 100;
    allow delete: if request.auth != null && (request.auth.uid == uid || isOnlineMJ());
  }

  // Le journal partagé (v0.182) : chaque ligne est écrite une fois par son auteur, en
  // texte et en chiffres. Tout le monde à la table le lit, le MJ seul le balaie.
  match /journal/{ligne} {
    allow get, list: if request.auth != null
      && !exists(/databases/$(database)/documents/amertume_online_live/$(table)/bannis/$(request.auth.uid));
    allow create: if request.auth != null
      && !exists(/databases/$(database)/documents/amertume_online_live/$(table)/bannis/$(request.auth.uid))
      && request.resource.data.de == request.auth.uid
      && request.resource.data.t is number
      && request.resource.data.keys().hasOnly(['t','de','tour','genre','texte','badge','logo','a','b','corps','detail','suite','effet','ton'])
      && request.resource.data.genre in ['texte','attaque','effet']
      && (!('texte' in request.resource.data) || request.resource.data.texte == null || request.resource.data.texte.size() <= 400);
    allow update: if false;
    allow delete: if isOnlineMJ();
  }
}
